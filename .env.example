# Copy to .env and fill in the values marked "replace-me" before running
# `npm run dev` / `npm run worker`, or `docker compose up -d --build`.
#
# Everything else has a working default for local development against the
# docker-compose.yml in this directory (Postgres on :5433, Redis on :6380).

NODE_ENV=development
PORT=1000
FRONTEND_ORIGIN=http://localhost:5173

# --- Postgres (docker compose in this repo exposes it on host port 5433) ---
DATABASE_URL=postgresql://caresense:caresense@localhost:5433/caresense

# --- Redis (docker compose in this repo exposes it on host port 6380) ---
REDIS_URL=redis://localhost:6380

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-replace-me
# Model names below match what this project was built and demoed against —
# change only if you know the replacement models support the same features
# (diarized transcription / strict JSON-schema structured output).
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_RECURRENCE_MODEL=gpt-5.6-luna
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_COACHING_MODEL=gpt-5.6-luna

# --- Cloudflare R2 (S3-compatible object storage, audio files only) ---
CLOUDFLARE_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=caresense
# Optional — only set if R2 objects are served from a public custom domain.
# Leave commented out (not "="): an unset var is optional, but "KEY=" is
# still a defined empty string and fails URL validation.
# R2_PUBLIC_BASE_URL=https://recordings.example.com

# --- ffmpeg / ffprobe (used for stereo channel splitting and audio
# preflight validation — silence/music/duration checks) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
